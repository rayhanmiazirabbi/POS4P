{
  "expo": {
    "name": "Pharmacy Platform",
    "slug": "pharmacy-platform",
    "scheme": "pharmacy-platform",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan medicine barcodes at the counter.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
